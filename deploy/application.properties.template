# ═══════════════════════════════════════════════════════
#  PRODUCTION CONFIG — /opt/algo-trading/application.properties
#  This file overrides the bundled classpath defaults.
#  Keep this file on the VPS only — never commit to git.
# ═══════════════════════════════════════════════════════

# ─── Angel One / SmartAPI credentials ───────────────────
broker.client.id=YOUR_CLIENT_ID
broker.pin=YOUR_PIN
broker.totp.secret=YOUR_TOTP_SECRET
broker.api.key=YOUR_API_KEY

# ─── Trading mode ────────────────────────────────────────
trading.mode=live

# ─── Live candle evaluation ───────────────────────────────
candle.timeframe=FIVE_MINUTE
candle.history.bars=20000
trading.live.historical.refresh.enabled=true
trading.live.historical.refresh.overlap.bars=3
trading.live.historical.refresh.fallback.only=true
trading.live.historical.refresh.max.symbols.per.cycle=1
trading.live.historical.refresh.sleep.ms=1500
trading.live.historical.refresh.cooldown.minutes=15
strategy.loop.settle.seconds=5
feed.mode=QUOTE
feed.stale.reconnect.seconds=180

# ─── Risk ─────────────────────────────────────────────────
risk.capital=1200000
risk.per.trade=0.01
risk.max.daily.loss=0.02
risk.max.daily.profit=0.10
risk.max.trades.day=10
risk.max.open.positions=5

# ─── Instrument ───────────────────────────────────────────
# EQUITY | FUTURES | OPTION_BUY | OPTION_WRITE
trading.instrument.type=OPTION_BUY
trading.option.lots=2
trading.option.buy.max.profit=6000
trading.option.buy.max.loss=3000
trading.option.write.max.profit=6000
trading.option.write.max.loss=3000
# Broker product types used by live orders.
# INTRADAY holdings use the intraday value and are square-off eligible.
# DELIVERY holdings use equity/derivative delivery values and are not auto squared off by the engine.
order.product.type.intraday=INTRADAY
order.product.type.delivery.equity=DELIVERY
order.product.type.delivery.derivatives=NRML
order.margin.calculator.enabled=true
order.margin.buffer.rs=1000
order.broker.funds.check.enabled=true
order.broker.flat.entry.cooldown.seconds=300
order.protected.limit=true
order.limit.wait.seconds=120

# ─── Database ─────────────────────────────────────────────
# VSRSI strategy
# LEGACY restores the earlier loose Supertrend proxy used by VSRSI.
# REAL uses the corrected trailing Supertrend calculation for testing/retuning.
strategy.vsrsi.trade.type=BOTH
strategy.vsrsi.holding.type=INTRADAY
strategy.vsrsi.instrument.type=FUTURES
strategy.vsrsi.futures.expiry.offset=0
strategy.vsrsi.futures.lots=1
strategy.vsrsi.option.expiry.offset=0
strategy.vsrsi.option.strike.offset=0
strategy.vsrsi.option.lots=1
strategy.vsrsi.supertrend.mode=LEGACY
strategy.mics.trade.type=BOTH
strategy.mics.holding.type=INTRADAY
strategy.ma.trade.type=BOTH
strategy.ma.holding.type=INTRADAY
strategy.rsi.trade.type=BOTH
strategy.rsi.holding.type=INTRADAY

db.url=jdbc:postgresql://localhost:5432/algo_db_v2
db.username=algo
db.password=CHANGE_ME_DB_PASSWORD

# ─── Telegram ─────────────────────────────────────────────
telegram.bot.token=YOUR_BOT_TOKEN
telegram.chat.id=YOUR_CHAT_ID
telegram.enabled=true

# ─── Health check ─────────────────────────────────────────
health.port=8080
health.enabled=true
