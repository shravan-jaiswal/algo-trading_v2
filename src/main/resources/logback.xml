<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_DIR" value="logs"/>
    <property name="APP"     value="algo-trading_v2"/>

    <!-- Console appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %-30logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Rolling file appender — daily rotation, 30 days retention -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP}.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %-30logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress noisy third-party loggers -->
    <logger name="com.angelbroking"     level="WARN"/>
    <logger name="okhttp3"              level="WARN"/>
    <logger name="org.quartz"           level="WARN"/>
    <logger name="com.zaxxer.hikari"    level="INFO"/>
    <logger name="org.ta4j"             level="WARN"/>

    <!-- Application logger — INFO in production, DEBUG for troubleshooting -->
    <logger name="com.trading" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
